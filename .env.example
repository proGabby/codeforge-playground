# Google Gemini API Key for Socratic AI Mentor
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Turso (LibSQL) Cloud Database Configuration
# Leave blank to automatically use local SQLite (server/data/codeforge.db)
# Create a free Turso DB with: turso db create codeforge && turso db show --url codeforge
TURSO_DATABASE_URL=
# Generate a token with: turso db tokens create codeforge
TURSO_AUTH_TOKEN=

# Optional Go Binary Path Override
# GO_BINARY=/usr/local/go/bin/go
